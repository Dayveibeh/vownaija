{
  "extends": "./tsconfig.json",
  "compilerOptions": { "incremental": false },
  "include": [
    "db/**/*.ts",
    "lib/**/*.ts",
    "app/onboarding/actions.ts",
    "app/api/vendors/**/*.ts",
    "app/api/vendor-workspace/**/*.ts",
    "app/api/vendor-media/**/*.ts",
