{
  "name": "@smitten/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "next build",
    "build:vercel": "npm run db:setup && SMITTEN_VERCEL_BUILD=1 next build",
    "start": "next start",
    "start:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:setup": "TSX_TSCONFIG_PATH=tsconfig.json node --import tsx scripts/setup-database.ts",
    "prestart": "npm run db:setup",
    "predev": "npm run db:setup",
    "test:vendors": "TSX_TSCONFIG_PATH=tsconfig.json node --experimental-test-module-mocks --import tsx --test tests/vendor-api.test.ts",
    "benchmark:vendors": "TSX_TSCONFIG_PATH=tsconfig.json node --import tsx scripts/benchmark-vendors.ts",
    "typecheck:vendors": "tsc --noEmit -p tsconfig.vendors.json"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.7.7",
    "@neondatabase/serverless": "^1.1.0",
    "@smitten/shared": "*",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^0.468.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
