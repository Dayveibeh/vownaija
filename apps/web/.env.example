NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
DATABASE_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/couples/sign-up?mode=signin
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/couples/sign-up

# Phase 3 payments — use a Paystack test secret key in Preview first.
PAYSTACK_SECRET_KEY=


# Canonical public app URL used for payment callbacks and notification links.
SMITTEN_PUBLIC_URL=

# Optional email notifications. In-app notifications work without these.
RESEND_API_KEY=
SMITTEN_EMAIL_FROM=


# Signed-in inactivity timeout. Defaults to 30 minutes with a 2 minute warning.
NEXT_PUBLIC_SESSION_IDLE_TIMEOUT_MINUTES=30
NEXT_PUBLIC_SESSION_TIMEOUT_WARNING_MINUTES=2
