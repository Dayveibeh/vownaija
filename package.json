{
  "name": "smitten",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=apps/web/.wrangler/wrangler.log vite \"$PWD/apps/web\"",
    "web": "npm --workspace @smitten/web run dev",
    "build": "bash scripts/build-verified.sh",
    "build:web": "npm --workspace @smitten/web run build",
    "build:vercel": "npm --workspace @smitten/web run build:vercel",
    "start": "npm --workspace @smitten/web run start:sites",
    "web:start": "npm --workspace @smitten/web run start",
    "test": "npm run build && node --test apps/web/tests/rendered-html.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "npm --workspace @smitten/web run lint",
    "db:generate": "npm --workspace @smitten/web run db:generate",
    "mobile:install": "npm --prefix apps/mobile install",
    "mobile": "npm --prefix apps/mobile run start",
    "mobile:ios": "npm --prefix apps/mobile run ios",
    "typecheck:mobile": "npm --prefix apps/mobile run typecheck"
  },
  "type": "module",
  "displayName": "Smitten"
}
